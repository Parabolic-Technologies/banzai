{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "operation", "ok", "result", "error"],
  "properties": {
    "schema": {
      "const": "banzai-artifact-result/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "operation": {
      "enum": [
        "inspect",
        "initialize",
        "create",
        "acquire",
        "write",
        "release",
        "inventory",
        "export",
        "verify",
        "restore",
        ""
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "result": {},
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "ARTIFACT_INPUT_INVALID",
                "RESOURCE_VERSION_UNSUPPORTED",
                "ARTIFACT_WORK_AMBIGUOUS",
                "ARTIFACT_RECOVERY_REQUIRED",
                "ARTIFACT_IGNORE_CONFLICT",
                "ARTIFACT_UNSAFE_PATH",
                "ARTIFACT_OWNERSHIP_CONFLICT",
                "ARTIFACT_EVIDENCE_INCOMPLETE",
                "ARTIFACT_DESTINATION_CONFLICT",
                "ARTIFACT_IO_ERROR",
                "ARTIFACT_SETUP_REQUIRED",
                "ARTIFACT_DISCOVERY_LIMIT"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "ok": {
          "const": true
        },
        "result": {
          "not": {
            "type": "null"
          }
        },
        "error": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "ok": {
          "const": false
        },
        "result": {
          "type": "null"
        },
        "error": {
          "type": "object"
        }
      }
    }
  ]
}
