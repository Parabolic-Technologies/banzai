{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "repoRoot"],
  "properties": {
    "schema": {
      "const": "banzai-artifact-request/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "repoRoot": {
      "type": "string",
      "minLength": 1
    },
    "workId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\\\u0000-\\u001f\\u007f]).+$"
    }
  },
  "not": {
    "required": ["workId", "workPath"]
  }
}
