              },
              "verificationDirectory": {
                "type": "string",
                "pattern": "^\\.banzai/runs/[A-Za-z0-9][A-Za-z0-9._-]{0,199}/verification$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "workflow"
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewDirectory",
              "description",
              "plan",
