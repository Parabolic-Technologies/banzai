              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\\\u0000-\\u001f\\u007f]).+$"
              },
              "plan": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\\\u0000-\\u001f\\u007f]).+$"
              },
              "implementationReport": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\\\u0000-\\u001f\\u007f]).+$"
              },
              "testReport": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\\\u0000-\\u001f\\u007f]).+$"
              },
              "work": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\\\u0000-\\u001f\\u007f]).+$"
              },
              "changeReport": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\\\u0000-\\u001f\\u007f]).+$"
              },
              "verificationDirectory": {
                "type": "string",
                "pattern": "^\\.banzai/runs/[A-Za-z0-9][A-Za-z0-9._-]{0,199}/verification$"
              }
            }
          }
        }
      }
    }
  ]
}
