{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "repoRoot",
    "slug",
    "mode",
    "creationId"
  ],
  "properties": {
    "schema": {
      "const": "banzai-artifact-request/v2"
    },
    "schemaVersion": {
      "const": 2
    },
    "repoRoot": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "mode": {
      "enum": [
        "strict",
        "lite",
        "fix",
        "workflow"
      ]
    },
    "creationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
