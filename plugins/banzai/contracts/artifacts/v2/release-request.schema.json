{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "repoRoot",
    "workPath",
    "token"
  ],
  "properties": {
    "schema": {
      "const": "banzai-artifact-request/v2"
    },
    "schemaVersion": {
      "const": 2
    },
    "repoRoot": {
      "type": "string",
      "minLength": 1
    },
    "workPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\\\u0000-\\u001f\\u007f]).+$"
    },
    "token": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
