{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "repoRoot",
    "workPath",
    "roundId"
  ],
  "properties": {
    "schema": {
      "const": "banzai-verification-request/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "repoRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "workPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "roundId": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    }
  }
}
