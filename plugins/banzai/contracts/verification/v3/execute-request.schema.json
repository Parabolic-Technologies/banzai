{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "repoRoot",
    "roundId",
    "documentPath",
    "workflow"
  ],
  "properties": {
    "schema": {
      "const": "banzai-verification-request/v3"
    },
    "schemaVersion": {
      "const": 3
    },
    "repoRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "roundId": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "retryOf": {
      "type": "string",
      "pattern": "^verification-[a-f0-9-]{36}$"
    },
    "documentPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "workflow": {
      "enum": [
        "strict",
        "feature",
        "quick-fix"
      ]
    }
  }
}
