{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banzai.local/contracts/v1/phase-result.schema.json",
  "title": "Banzai orchestrated phase result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "phase": {
      "type": "string",
      "enum": [
        "plan",
        "implementation",
        "fix"
      ]
    },
    "outcome": {
      "type": "string",
      "description": "Use needs_human_decision whenever gate is non-null. Use completed only with gate null.",
      "enum": [
        "completed",
        "needs_human_decision",
        "blocked"
      ]
    },
    "gate": {
      "type": [
        "string",
        "null"
      ],
      "description": "A non-null gate transfers control to the human through the interactive orchestrator and requires outcome needs_human_decision.",
      "enum": [
        "adr_approval",
        "plan_approval",
        "escalation",
        null
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        },
        "adrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implementationReport": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "description",
        "plan",
        "adrs",
        "implementationReport"
      ]
    },
    "touchedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolvedFindingIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requestedVerification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "contractVersion",
    "phase",
    "outcome",
    "gate",
    "summary",
    "artifacts",
    "touchedPaths",
    "questions",
    "resolvedFindingIds",
    "requestedVerification"
  ]
}
