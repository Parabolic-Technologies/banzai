{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banzai.local/contracts/v1/planning-review-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "schema",
    "schemaVersion",
    "reviewNumber",
    "scope",
    "findings"
  ],
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema": {
      "type": "string",
      "const": "banzai-planning-review-result/v1"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "reviewNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "summary",
          "evidence",
          "suggestedResolution",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^P[1-9][0-9]*-F[1-9][0-9]*$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "should_fix",
              "nit"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "requirements",
              "acceptance",
              "architecture",
              "plan",
              "consistency",
              "security",
              "testing",
              "scope",
              "compatibility",
              "documentation"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "line",
                "detail"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "line": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "detail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          },
          "suggestedResolution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    }
  }
}
