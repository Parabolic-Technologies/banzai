{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banzai.local/contracts/v1/planning-review-analysis.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "schema",
    "schemaVersion",
    "reviewNumber",
    "resultDigest",
    "entries"
  ],
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema": {
      "type": "string",
      "const": "banzai-planning-review-analysis/v1"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "reviewNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "resultDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "assessment",
          "rationale",
          "options",
          "recommendation"
        ],
        "properties": {
          "findingId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^P[1-9][0-9]*-F[1-9][0-9]*$"
          },
          "assessment": {
            "type": "string",
            "enum": [
              "agree",
              "partially_agree",
              "disagree"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "optionId",
                "label",
                "consequences"
              ],
              "properties": {
                "optionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "consequences": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            }
          },
          "recommendation": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "optionId",
                  "rationale"
                ],
                "properties": {
                  "optionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
