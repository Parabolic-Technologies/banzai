  "ci": {
    "workflow": ".github/workflows/ci.yml",
    "liveJob": "live_vendor_compatibility",
    "liveInput": "live_compatibility",
    "liveEnableVariable": "BANZAI_LIVE_COMPATIBILITY",
    "liveEnableValue": "1",
    "liveRunnerTag": "banzai-live"
  },
  "live": {
    "summarySchema": "banzai-live-compatibility/v2",
    "summarySchemaVersion": 2,
    "maxInvocations": 2,
    "perInvocationTimeoutMs": 300000,
    "totalTimeoutMs": 900000,
    "minimumCliVersions": {
      "codex": "0.145.0",
      "claude": "2.1.218"
    },
    "authRootVariables": {
      "codex": "BANZAI_LIVE_CODEX_AUTH_ROOT",
      "claude": "BANZAI_LIVE_CLAUDE_AUTH_ROOT"
    },
    "models": {
      "codex": {
        "model": "gpt-5.6-luna",
        "effort": "low"
      },
      "claude": {
        "model": "claude-haiku-4-5",
        "effort": "low"
      }
    }
  },
